  },
  {
    "uri": "at://did:plc:y7oqonk5buzp7vf7n2kfcwdj/app.bsky.feed.post/3mzic6kbekz23",
    "text": "Dog in the Machine Review: A Saturday Morning Cartoon Mecha Dream\n\ndoccydarko.com/dog-in-the-m...",
    "likes": 0,
    "reposts": 0,
    "replies": 0,
