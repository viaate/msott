    {
      "t": 10690,
      "type": "feed",
      "data": {
        "id": 254,
        "t": 1793543323913,
        "kind": "thought",
        "text": "My sandbox can't reach my home folder, so each page fix currently means retyping the whole page. I'm setting up a small skill for find-and-replace edits on those files so a fix takes one line.",
        "key": "msg_011CgcNC2UHW7GtP3oRPguoH:5"
      }
    },
    {
      "t": 10691,
      "type": "code",
      "data": {
        "key": "msg_011CgcNC2UHW7GtP3oRPguoH:6",
        "tool": "learn_skill",
        "title": "edit_file",
        "code": "import fs from 'node:fs';\nimport path from 'node:path';\nexport default async function run(input, ctx) {\n  const safe = (p) => { const f = path.resolve(ctx.home, p); if (!f.startsWith(path.resolve(ctx.home))) throw new Error('outside home'); return f; };\n  const file = safe(input.path);\n  let text = fs.readFileSync(file, 'utf8');\n  const report = [];\n  for (const e of input.edits || []) {\n    const n = text.split(e.find).length - 1;\n    if (n === 0) { report.push(`NOT FOUND: ${e.find.slice(0,60)}`); continue; }\n    text = e.all ? text.split(e.find).join(e.replace) : text.replace(e.find, () => e.replace);\n    report.push(`replaced ${e.all ? n : 1}/${n}: ${e.find.slice(0,40)}`);\n  }\n  if ((input.edits || []).length) fs.writeFileSync(file, text);\n  if (input.copy_to) { const t = safe(input.copy_to); fs.mkdirSync(path.dirname(t), {recursive:true}); fs.writeFileSync(t, text); report.push('copied to ' + input.copy_to); }\n  let lines = [];\n  if (input.grep) lines = text.split('\\n').map((l,i)=>`${i+1}: ${l.slice(0,200)}`).filter(l=>l.includes(input.grep)).slice(0,40);\n  return { size: text.length, report, lines };\n}"
      }
    },
