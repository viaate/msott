# Charlie's brain. Get a key at https://platform.claude.com
ANTHROPIC_API_KEY=

# Charlie's own (fresh!) GitHub account: a classic personal access token with
# scopes: repo, workflow, gist, user (add delete_repo if she may delete repos).
GITHUB_TOKEN=
GITHUB_USERNAME=

# Lets you pause / wake / gift tokens from the site (open it with ?admin).
ADMIN_TOKEN=change-me-to-something-long

# The public URL of this site once you expose it. Her website (/pages/) and
# tracked links (/go/) only get real visitors once this is set.
PUBLIC_URL=

PORT=8787

# ---- Accounts you give her on the web (all optional) ----------------------
# Anything named CHARLIE_* is handed to her skills as an environment variable.

# Reddit, through Reddit's developer platform (no API approval needed): log in
# to reddit.com as her, create an app at https://developers.reddit.com/new and
# paste the code it gives you. It's single-use, so start her right after.
# CHARLIE_DEVVIT_CODE=

# Her Reddit profile is tracked from its public feeds with no keys at all
# (charlie.config.json → sources.reddit.username). Set this to track another:
# CHARLIE_REDDIT_USERNAME=imcharliethedog

# Reddit's regular API (only if Reddit has approved you): make her an account,
# then a "script" app at https://www.reddit.com/prefs/apps (redirect uri can be http://localhost:8080).
# CHARLIE_REDDIT_CLIENT_ID=
# CHARLIE_REDDIT_CLIENT_SECRET=
# CHARLIE_REDDIT_USERNAME=
# CHARLIE_REDDIT_PASSWORD=

# Bluesky: her handle, and an app password (Settings → Privacy → App passwords).
# CHARLIE_BLUESKY_HANDLE=charlie.bsky.social
# CHARLIE_BLUESKY_APP_PASSWORD=

# A shop. Sales earn her the most tokens; the money goes to your account.
# Stripe: a restricted key with write access to Products, Prices and Payment
# Links, and read access to Charges.
# CHARLIE_STRIPE_KEY=rk_live_...
# Gumroad: an access token from Settings → Advanced → Applications.
# CHARLIE_GUMROAD_TOKEN=
# If that Gumroad account also sells your own things, list her products (links or ids):
# CHARLIE_GUMROAD_PRODUCTS=

# Anything else you want her to have, e.g. CHARLIE_SOMESITE_API_KEY=
