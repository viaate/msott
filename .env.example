# Charlie's brain. Get a key at https://platform.claude.com
ANTHROPIC_API_KEY=

# Charlie's own (fresh!) GitHub account: a classic personal access token with
# scopes: repo, workflow, gist, user (add delete_repo if she may delete repos).
GITHUB_TOKEN=
GITHUB_USERNAME=

# Lets you pause / wake / gift tokens from the site (open it with ?admin).
ADMIN_TOKEN=change-me-to-something-long

# The public URL of this site once you expose it (enables her view beacon).
PUBLIC_URL=

PORT=8787

# Anything named CHARLIE_* is handed to Charlie's skills as an environment
# variable, e.g. other accounts you decide to give her later:
# CHARLIE_BLUESKY_HANDLE=
# CHARLIE_BLUESKY_APP_PASSWORD=
